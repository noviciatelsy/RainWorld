  m_Script: {fileID: 11500000, guid: 632e77a2afa0f904abd9351b623f3b87, type: 3}
  m_Name: DialogueData - Intelligencer_Tutorial
  m_EditorClassIdentifier: 
  defaultCharacterSprite: {fileID: 21300000, guid: eb6fbebb458b95844ac1653e0baa55c8,
    type: 3}
  segments:
  - characterSprite: {fileID: 0}
    content: "\u5618\u2026\u2026\u811A\u6B65\u58F0\u592A\u54CD\u4E86\uFF0C\u63A2\u9669\u5BB6\u3002\u5BC6\u7A9F\u4F1A\u542C\uFF0C\u7EB8\u4F1A\u542C\uFF0C\u8FDE\u4F60\u80CC\u5305\u7F1D\u91CC\u7684\u7070\u5C18\u90FD\u4F1A\u542C"
  - characterSprite: {fileID: 0}
    content: "\u522B\u7D27\u5F20\uFF0C\u6211\u4E0D\u5403\u4EBA\u3002\u6211\u53EA\u5403\u60C5\u62A5\uFF0C\u70ED\u7684\u3001\u51B7\u7684\u3001\u65B0\u9C9C\u7684\u3001\u8150\u70C2\u7684\u2026\u2026\u53EA\u8981\u662F\u771F\u7684\uFF0C\u6211\u90FD\u8981"
  - characterSprite: {fileID: 0}
    content: "\u4F60\u4ECE\u4E0B\u9762\u56DE\u6765\u65F6\uFF0C\u8EAB\u4E0A\u603B\u4F1A\u6CBE\u7740\u4E1C\u897F\uFF1A\u602A\u7269\u7684\u4E60\u6027\u3001\u5C94\u8DEF\u7684\u65B9\u5411\u3001\u77F3\u95E8\u540E\u7684\u56DE\u58F0\uFF0C\u8FD8\u6709\u5DEE\u70B9\u5BB3\u6B7B\u4F60\u7684\u9519\u8BEF"
  - characterSprite: {fileID: 0}
    content: "\u8FD9\u4E9B\u4E1C\u897F\u5728\u522B\u4EBA\u773C\u91CC\u53EA\u662F\u7ECF\u5386\uFF0C\u5728\u6211\u773C\u91CC\u53EF\u90FD\u662F\u8D27\u5E01\uFF0C\u6BD4\u91D1\u5E01\u8F7B\uFF0C\u6BD4\u8840\u503C\u94B1\uFF0C\u6BD4\u5200\u5B50\u66F4\u80FD\u8BA9\u4EBA\u6D3B\u4E45\u4E00\u70B9"
  - characterSprite: {fileID: 0}
    content: "\u4F60\u4E0D\u662F\u6709\u672C\u7B14\u8BB0\u5417\uFF1F\u4F60\u89C1\u8FC7\u7684\u4E1C\u897F\u3001\u542C\u6765\u7684\u4F20\u95FB\u3001\u786E\u8BA4\u8FC7\u7684\u89C4\u5F8B\uFF0C\u90FD\u4F1A\u88AB\u8BB0\u8FDB\u53BB\uFF1B\u60F3\u7FFB\u770B\u7684\u65F6\u5019\uFF0C\u6309\u4E0B
      B \u5C31\u884C"
  - characterSprite: {fileID: 0}
    content: "\u4E0D\u8FC7\uFF0C\u7B14\u8BB0\u53EA\u4F1A\u8BB0\u4E0B\u4F60\u5DF2\u7ECF\u77E5\u9053\u7684\u4E8B\u3002\u4F60\u6CA1\u89C1\u8FC7\u7684\u602A\u7269\u3001\u6CA1\u8D70\u8FC7\u7684\u8DEF\u3001\u6CA1\u89E6\u53D1\u8FC7\u7684\u5371\u9669\uFF0C\u5B83\u53EF\u4E0D\u4F1A\u51ED\u7A7A\u544A\u8BC9\u4F60"
  - characterSprite: {fileID: 0}
    content: "\u6240\u4EE5\u4F60\u53EF\u4EE5\u6765\u627E\u6211\u3002\u82B1\u4E00\u70B9\u94B1\uFF0C\u6211\u5C31\u5356\u4F60\u4E00\u70B9\u6D88\u606F\uFF1A\u602A\u7269\u7684\u4E60\u60EF\u3001\u73AF\u5883\u7684\u89C4\u5F8B\u3001\u67D0\u6761\u8DEF\u4E3A\u4EC0\u4E48\u603B\u6709\u4EBA\u56DE\u4E0D\u6765"
  - characterSprite: {fileID: 0}
    content: "\u522B\u5ACC\u8D35\uFF0C\u63A2\u9669\u5BB6\u3002\u4F60\u4E70\u7684\u4E0D\u662F\u51E0\u884C\u5B57\uFF0C\u662F\u5C11\u6454\u4E00\u6B21\u5751\u3001\u5C11\u88AB\u54AC\u4E00\u53E3\u3001\u5C11\u5728\u9ED1\u6697\u91CC\u505A\u4E00\u6B21\u9519\u8BEF\u51B3\u5B9A"
  - characterSprite: {fileID: 0}
    content: "\u5F53\u7136\uFF0C\u6709\u4E9B\u60C5\u62A5\u6211\u4E0D\u5356\u3002\u4E0D\u662F\u56E0\u4E3A\u6211\u4EC1\u6148\uFF0C\u4E5F\u4E0D\u662F\u56E0\u4E3A\u6211\u6E05\u9AD8\uFF0C\u800C\u662F\u56E0\u4E3A\u91D1\u5E01\u592A\u8F7B\uFF0C\u538B\u4E0D\u4F4F\u90A3\u4E9B\u79D8\u5BC6"
  - characterSprite: {fileID: 0}
    content: "\u771F\u6B63\u91CD\u8981\u7684\u60C5\u62A5\uFF0C\u9700\u8981\u7528\u522B\u7684\u60C5\u62A5\u6765\u6362\u3002\u4F60\u66FF\u6211\u89C2\u5BDF\u602A\u7269\u3001\u8BB0\u5F55\u5F02\u5E38\u3001\u5E26\u56DE\u5730\u4E0B\u7684\u89C1\u95FB\uFF0C\u6211\u5C31\u544A\u8BC9\u4F60\u66F4\u6DF1\u5904\u7684\u4E1C\u897F"
  - characterSprite: {fileID: 0}
    content: "\u4F60\u53EF\u4EE5\u628A\u81EA\u5DF1\u6536\u96C6\u5230\u7684\u60C5\u62A5\u4EA4\u7ED9\u6211\uFF0C\u7B49\u5206\u91CF\u591F\u4E86\uFF0C\u6211\u4F1A\u62FF\u51FA\u5BF9\u5E94\u4EF7\u503C\u7684\u79D8\u5BC6\u3002\u522B\u62C5\u5FC3\uFF0C\u6211\u4E0D\u9A97\u50BB\u5B50\u4EE5\u5916\u7684\u4EBA"
  - characterSprite: {fileID: 0}
    content: "\u8BB0\u4F4F\uFF0C\u63A2\u9669\u5BB6\uFF0C\u5BC6\u7A9F\u91CC\u6700\u5371\u9669\u7684\u4E0D\u662F\u602A\u7269\uFF0C\u800C\u662F\u4F60\u4EE5\u4E3A\u81EA\u5DF1\u5DF2\u7ECF\u61C2\u4E86\u3002\u9519\u8BEF\u7684\u8BA4\u77E5\uFF0C\u6BD4\u5C16\u7259\u66F4\u4F1A\u6740\u4EBA"
  - characterSprite: {fileID: 0}
    content: "\u53BB\u5427\uFF0C\u66FF\u6211\u770B\uFF0C\u66FF\u6211\u542C\uFF0C\u66FF\u6211\u628A\u5BC6\u7A9F\u7684\u79D8\u5BC6\u5265\u4E0B\u6765\u3002\u4F60\u5F97\u5230\u6D3B\u4E0B\u53BB\u7684\u65B9\u6CD5\uFF0C\u6211\u5F97\u5230\u53EF\u7231\u7684\u60C5\u62A5\u2026\u2026\u5F88\u516C\u5E73\uFF0C\u4E0D\u662F\u5417\uFF1F"
