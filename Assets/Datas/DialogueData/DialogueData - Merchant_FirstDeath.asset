  m_Script: {fileID: 11500000, guid: 632e77a2afa0f904abd9351b623f3b87, type: 3}
  m_Name: DialogueData - Merchant_FirstDeath
  m_EditorClassIdentifier: 
  defaultCharacterSprite: {fileID: 21300000, guid: ef4f01e20c22a7c468a60c359aa0cda7,
    type: 3}
  segments:
  - characterSprite: {fileID: 0}
    content: "\u54CE\u5440\u5440\uFF0C\u6B22\u8FCE\u56DE\u6765\uFF0C\u534A\u6B7B\u4E0D\u6D3B\u7684\u5C0F\u63A2\u9669\u5BB6\u3002\u4F60\u521A\u624D\u90A3\u526F\u6837\u5B50\uFF0C\u53EF\u6BD4\u6211\u67DC\u53F0\u4E0A\u7684\u65E7\u62B9\u5E03\u8FD8\u96BE\u770B"
  - characterSprite: {fileID: 0}
    content: "\u522B\u6025\u7740\u6478\u80CC\u5305\u5566\uFF0C\u7A7A\u7684\u3002\u4F60\u5012\u5728\u5730\u4E0B\u7684\u65F6\u5019\uFF0C\u4EBA\u662F\u88AB\u5DE1\u903B\u7684\u63A2\u9669\u8005\u62D6\u56DE\u6765\u4E86\uFF0C\u4E1C\u897F\u53EF\u6CA1\u4EBA\u6709\u7A7A\u66FF\u4F60\u4E00\u4EF6\u4EF6\u6361"
  - characterSprite: {fileID: 0}
    content: "\u4E0B\u6B21\u518D\u8FDB\u5BC6\u7A9F\u65F6\uFF0C\u53BB\u5012\u4E0B\u7684\u4F4D\u7F6E\u627E\u627E\uFF0C\u90A3\u91CC\u4F1A\u7559\u4E0B\u4F60\u7684\u9057\u5931\u80CC\u5305\uFF0C\u91CC\u9762\u88C5\u7740\u4E0A\u6B21\u6CA1\u5E26\u56DE\u6765\u7684\u4E1C\u897F"
  - characterSprite: {fileID: 0}
    content: "\u4E0D\u8FC7\u561B\uFF0C\u5BC6\u7A9F\u53EF\u4E0D\u4F1A\u56E0\u4E3A\u4F60\u60F3\u6361\u56DE\u4E1C\u897F\u5C31\u53D8\u6E29\u67D4\u3002\u90A3\u6761\u8DEF\u4E0A\u6709\u4EC0\u4E48\u602A\u7269\u3001\u9677\u9631\u548C\u5012\u9709\u4E8B\uFF0C\u8FD8\u662F\u4F1A\u4E56\u4E56\u7B49\u7740\u4F60"
  - characterSprite: {fileID: 0}
    content: "\u6240\u4EE5\u522B\u4E00\u9192\u6765\u5C31\u6025\u7740\u51B2\u4E0B\u53BB\u3002\u5148\u60F3\u60F3\u8DEF\u7EBF\uFF0C\u5E26\u70B9\u80FD\u4FDD\u547D\u7684\u5DE5\u5177\uFF0C\u80CC\u5305\u4E5F\u7559\u51FA\u7A7A\u95F4\uFF0C\u4E0D\u7136\u4F60\u6361\u5230\u4E86\u4E5F\u585E\u4E0D\u4E0B"
  - characterSprite: {fileID: 0}
    content: "\u8981\u662F\u4F60\u53C8\u5728\u534A\u8DEF\u5012\u4E0B\uFF0C\u90A3\u53EF\u5C31\u66F4\u96BE\u770B\u4E86\u3002\u5230\u65F6\u5019\u662F\u6361\u80CC\u5305\uFF0C\u8FD8\u662F\u7ED9\u65B0\u80CC\u5305\u966A\u846C\uFF0C\u53EF\u5C31\u8BF4\u4E0D\u51C6\u54AF"
  - characterSprite: {fileID: 0}
    content: "\u53BB\u5427\uFF0C\u4F11\u6574\u597D\u4E86\u518D\u4E0B\u53BB\u3002\u628A\u81EA\u5DF1\u7684\u4E1C\u897F\u5E26\u56DE\u6765\uFF0C\u7136\u540E\u8BE5\u5B58\u7684\u5B58\uFF0C\u8BE5\u5356\u7684\u5356\uFF0C\u5C24\u5176\u662F\u5356\u7ED9\u6211\uFF0C\u61C2\u4E86\u5417"
