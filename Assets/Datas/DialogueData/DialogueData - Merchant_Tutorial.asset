  m_Script: {fileID: 11500000, guid: 632e77a2afa0f904abd9351b623f3b87, type: 3}
  m_Name: DialogueData - Merchant_Tutorial
  m_EditorClassIdentifier: 
  defaultCharacterSprite: {fileID: 21300000, guid: ef4f01e20c22a7c468a60c359aa0cda7,
    type: 3}
  segments:
  - characterSprite: {fileID: 0}
    content: "\u54CE\u5440\u5440\uFF0C\u7EC8\u4E8E\u9192\u5566\uFF1F\u6211\u8FD8\u4EE5\u4E3A\u4F60\u521A\u5230\u8425\u5730\u7B2C\u4E00\u5929\u5C31\u8981\u88AB\u5BC6\u7A9F\u5413\u56DE\u8001\u5BB6\u4E86\u5462\uFF0C\u5C0F\u63A2\u9669\u5BB6"
  - characterSprite: {fileID: 0}
    content: "\u522B\u6446\u51FA\u90A3\u79CD\u8868\u60C5\u561B\uFF0C\u50CF\u4F60\u8FD9\u6837\u542C\u8BF4\u65B0\u5BC6\u7A9F\u88AB\u6316\u51FA\u6765\uFF0C\u5C31\u6025\u7740\u8DD1\u6765\u5BFB\u627E\u6700\u6DF1\u5904\u79D8\u5BC6\u7684\u4EBA\uFF0C\u8FD9\u51E0\u5929\u53EF\u662F\u4E00\u6293\u4E00\u5927\u628A"
  - characterSprite: {fileID: 0}
    content: "\u8FD9\u91CC\u5C31\u662F\u8425\u5730\uFF0C\u63A2\u9669\u5BB6\u3001\u642C\u8FD0\u5DE5\u3001\u60C5\u62A5\u8D29\u5B50\uFF0C\u8FD8\u6709\u6211\u8FD9\u79CD\u53EF\u7231\u53C8\u53EF\u9760\u7684\u5546\u4EBA\uFF0C\u5168\u90FD\u6682\u65F6\u6324\u5728\u8FD9\u7247\u7834\u5730\u65B9\u8BA8\u751F\u6D3B"
  - characterSprite: {fileID: 0}
    content: "\u4F60\u8981\u505A\u7684\u4E8B\u4E5F\u5F88\u7B80\u5355\uFF1A\u4E0B\u5230\u5730\u4E0B\uFF0C\u641C\u522E\u6709\u4EF7\u503C\u7684\u4E1C\u897F\uFF0C\u522B\u88AB\u602A\u7269\u5403\u6389\uFF0C\u7136\u540E\u5728\u6491\u4E0D\u4F4F\u4E4B\u524D\u6D3B\u7740\u64A4\u56DE\u6765"
  - characterSprite: {fileID: 0}
    content: "\u5730\u4E0B\u80FD\u7FFB\u51FA\u6765\u7684\u4E1C\u897F\u53EF\u4E0D\u5C11\uFF0C\u5DE5\u5177\u3001\u6750\u6599\u3001\u98DF\u7269\u3001\u65E7\u673A\u5668\u3001\u5947\u602A\u690D\u7269\u2026\u2026\u6709\u4E9B\u80FD\u6551\u547D\uFF0C\u6709\u4E9B\u80FD\u5356\u94B1\uFF0C\u6709\u4E9B\u53EA\u4F1A\u628A\u4F60\u7684\u80CC\u5305\u585E\u6210\u5783\u573E\u5806"
  - characterSprite: {fileID: 0}
    content: "\u5982\u679C\u4F60\u6210\u529F\u628A\u4E1C\u897F\u5E26\u56DE\u8425\u5730\uFF0C\u53F3\u8FB9\u90A3\u4E2A\u50A8\u7269\u7BB1\u53EF\u4EE5\u7528\u6765\u5B58\u8D27\uFF1B\u4E0B\u6B21\u60F3\u518D\u5E26\u51FA\u53BB\u7528\u7684\uFF0C\u5C31\u8001\u8001\u5B9E\u5B9E\u653E\u8FDB\u53BB\uFF0C\u522B\u5168\u538B\u5728\u81EA\u5DF1\u80CC\u4E0A\u901E\u5F3A"
  - characterSprite: {fileID: 0}
    content: "\u5F53\u7136\u5566\uFF0C\u4F60\u4E5F\u53EF\u4EE5\u628A\u4E1C\u897F\u5356\u7ED9\u6211\uFF1B\u8981\u662F\u67D0\u79CD\u8D27\u6211\u6536\u5F97\u591F\u591A\uFF0C\u53C8\u786E\u8BA4\u5B83\u6709\u7A33\u5B9A\u4EF7\u503C\uFF0C\u6211\u5C31\u80FD\u60F3\u529E\u6CD5\u5927\u6279\u91CF\u8FDB\u8D27\uFF0C\u518D\u6446\u5230\u8D27\u67B6\u4E0A\u5356\u7ED9\u4F60"
  - characterSprite: {fileID: 0}
    content: "\u542C\u8D77\u6765\u50CF\u6211\u8D5A\u4E86\uFF1F\u54CE\u5440\uFF0C\u522B\u8BF4\u5F97\u90A3\u4E48\u96BE\u542C\u561B\uFF0C\u4F60\u83B7\u5F97\u91D1\u5E01\u548C\u8865\u7ED9\uFF0C\u6211\u83B7\u5F97\u8D27\u6E90\u548C\u5229\u6DA6\uFF0C\u8FD9\u53EB\u53CC\u8D62\u2014\u2014\u53EA\u662F\u6211\u8D62\u5F97\u7A0D\u5FAE\u591A\u4E00\u70B9\u70B9\u800C\u5DF2"
  - characterSprite: {fileID: 0}
    content: "\u4F60\u7684\u80CC\u5305\u8FD8\u662F\u8001\u89C4\u77E9\uFF0C\u6309\u4E0B
      Tab \u5C31\u80FD\u6253\u5F00\u7269\u54C1\u680F\uFF1B\u7528\u9F20\u6807\u5DE6\u952E\u62FF\u8D77\u548C\u653E\u4E0B\u7269\u54C1\uFF0C\u6446\u4E0D\u8FDB\u53BB\u7684\u65F6\u5019\u5C31\u7528\u9F20\u6807\u53F3\u952E\u628A\u5B83\u8F6C\u4E2A\u65B9\u5411"
  - characterSprite: {fileID: 0}
    content: "\u80CC\u5305\u91CC\u7684\u6BCF\u4E00\u683C\u90FD\u5F88\u503C\u94B1\uFF0C\u4E1C\u897F\u6A2A\u7740\u653E\u8FD8\u662F\u7AD6\u7740\u653E\uFF0C\u53EF\u80FD\u5C31\u51B3\u5B9A\u4F60\u80FD\u4E0D\u80FD\u591A\u5E26\u4E00\u4EF6\u5B9D\u8D1D\u56DE\u6765\uFF0C\u6216\u8005\u5C11\u4E22\u4E00\u6761\u5C0F\u547D"
  - characterSprite: {fileID: 0}
    content: "\u8981\u662F\u5728\u4E0B\u9762\u6361\u5230\u523B\u7740\u602A\u5B57\u7684\u77F3\u677F\uFF0C\u522B\u6025\u7740\u5ACC\u5B83\u5360\u5730\u65B9\uFF1B\u4F60\u770B\u4E0D\u61C2\u5F88\u6B63\u5E38\uFF0C\u628A\u5B83\u5356\u7ED9\u6211\uFF0C\u6211\u53EF\u4EE5\u66FF\u4F60\u627E\u4EBA\u7FFB\u8BD1\u51FA\u91CC\u9762\u7684\u5185\u5BB9"
  - characterSprite: {fileID: 0}
    content: "\u5F53\u7136\uFF0C\u77E5\u8BC6\u53EF\u4E0D\u662F\u514D\u8D39\u7684\uFF0C\u5C24\u5176\u662F\u90A3\u79CD\u80FD\u8BA9\u63A2\u9669\u5BB6\u5C11\u6B7B\u51E0\u6B21\u7684\u77E5\u8BC6\uFF1B\u4E0D\u8FC7\u4F60\u80AF\u5B9A\u4E5F\u60F3\u77E5\u9053\u5BC6\u7A9F\u6DF1\u5904\u5230\u5E95\u85CF\u4E86\u4EC0\u4E48\uFF0C\u5BF9\u5427"
  - characterSprite: {fileID: 0}
    content: "\u4F60\u8FD8\u662F\u6709\u8FB9\u63A2\u9669\u8FB9\u8BB0\u7B14\u8BB0\u7684\u4E60\u60EF\u5427\uFF1F\u9047\u5230\u7684\u602A\u7269\u3001\u53D1\u73B0\u7684\u89C4\u5F8B\u3001\u542C\u6765\u7684\u60C5\u62A5\uFF0C\u90FD\u4F1A\u88AB\u4F60\u8BB0\u8FDB\u672C\u5B50\u91CC\uFF0C\u6309\u4E0B
      B \u5C31\u80FD\u7FFB\u51FA\u6765\u770B\u770B"
  - characterSprite: {fileID: 0}
    content: "\u5728\u5730\u4E0B\uFF0C\u77E5\u9053\u4E00\u53EA\u602A\u7269\u4EC0\u4E48\u65F6\u5019\u4F1A\u8FFD\u4F60\u3001\u6015\u4EC0\u4E48\u3001\u600E\u4E48\u7ED5\u8FC7\u53BB\uFF0C\u6709\u65F6\u5019\u6BD4\u591A\u5E26\u4E00\u4EF6\u6B66\u5668\u8FD8\u503C\u94B1\uFF0C\u6BD5\u7ADF\u4F60\u53EF\u4E0D\u662F\u4EC0\u4E48\u65E0\u654C\u82F1\u96C4"
  - characterSprite: {fileID: 0}
    content: "\u8BF4\u5230\u602A\u7269\uFF0C\u6211\u8FD9\u91CC\u8FD8\u5356\u7167\u76F8\u673A\uFF1B\u7B49\u4F60\u6709\u94B1\u4E86\u53EF\u4EE5\u4E70\u4E00\u53F0\uFF0C\u628A\u602A\u7269\u7684\u6837\u5B50\u62CD\u4E0B\u6765\uFF0C\u8FD9\u6837\u5B83\u4EEC\u4E5F\u80FD\u88AB\u8BB0\u5F55\u8FDB\u4F60\u7684\u7B14\u8BB0\u672C\u91CC"
  - characterSprite: {fileID: 0}
    content: "\u522B\u8BEF\u4F1A\uFF0C\u4E0D\u662F\u8BA9\u4F60\u7ED9\u602A\u7269\u62CD\u6F02\u4EAE\u5199\u771F\uFF0C\u662F\u4E3A\u4E86\u8BA9\u4F60\u4E0B\u6B21\u770B\u5230\u7C7B\u4F3C\u7684\u5F71\u5B50\u65F6\uFF0C\u80FD\u7ACB\u523B\u60F3\u8D77\u6765\u81EA\u5DF1\u8BE5\u8DD1\u3001\u8BE5\u8EB2\uFF0C\u8FD8\u662F\u8BE5\u638F\u5DE5\u5177"
  - characterSprite: {fileID: 0}
    content: "\u8FD8\u6709\uFF0C\u522B\u5728\u5730\u4E0B\u78E8\u8E6D\u592A\u4E45\uFF1B\u90A3\u5730\u65B9\u7A7A\u6C14\u53C8\u95F7\u53C8\u810F\uFF0C\u8FD8\u98D8\u7740\u4E71\u4E03\u516B\u7CDF\u7684\u5B62\u5C18\uFF0C\u4F60\u997F\u7740\u809A\u5B50\u5F85\u4E45\u4E86\uFF0C\u8EAB\u4F53\u4F1A\u8D8A\u6765\u8D8A\u6491\u4E0D\u4F4F"
  - characterSprite: {fileID: 0}
    content: "\u7B80\u5355\u8BF4\uFF0C\u9965\u997F\u4F1A\u538B\u4F4E\u4F60\u7684\u751F\u547D\u4E0A\u9650\uFF1B\u4E0D\u662F\u4F60\u7A81\u7136\u53D8\u8106\u4E86\uFF0C\u800C\u662F\u4F60\u7684\u4F53\u529B\u3001\u6062\u590D\u529B\u548C\u5FCD\u8010\u529B\u90FD\u88AB\u5BC6\u7A9F\u4E00\u70B9\u70B9\u69A8\u5E72\u4E86"
  - characterSprite: {fileID: 0}
    content: "\u6240\u4EE5\u8BB0\u5F97\u5E26\u70B9\u5403\u7684\uFF0C\u6211\u8FD9\u91CC\u6709\u5356\uFF0C\u5730\u4E0B\u4E5F\u53EF\u80FD\u641C\u5230\uFF1B\u4E0D\u8FC7\u5730\u4E0B\u6361\u6765\u7684\u98DF\u7269\u561B\u2026\u2026\u80FD\u4E0D\u80FD\u653E\u5FC3\u5403\uFF0C\u5C31\u770B\u4F60\u80C6\u5B50\u548C\u80A0\u80C3\u54EA\u4E2A\u66F4\u786C\u4E86"
  - characterSprite: {fileID: 0}
    content: "\u8FF7\u8DEF\u7684\u65F6\u5019\u522B\u901E\u5F3A\uFF0C\u6309\u4E0B
      M \u5C31\u80FD\u6253\u5F00\u4F60\u81EA\u5DF1\u753B\u7684\u5730\u56FE\uFF1B\u5B83\u4F1A\u663E\u793A\u4F60\u5DF2\u7ECF\u63A2\u7D22\u8FC7\u7684\u533A\u57DF\uFF0C\u81F3\u5C11\u80FD\u8BA9\u4F60\u5C11\u5728\u540C\u4E00\u4E2A\u5C94\u8DEF\u53E3\u7ED5\u5708"
  - characterSprite: {fileID: 0}
    content: "\u6CA1\u53BB\u8FC7\u7684\u5730\u65B9\uFF0C\u5730\u56FE\u5F53\u7136\u4E0D\u4F1A\u81EA\u5DF1\u957F\u51FA\u6765\uFF1B\u60F3\u77E5\u9053\u66F4\u6DF1\u5904\u6709\u4EC0\u4E48\uFF0C\u5C31\u53EA\u80FD\u4EB2\u81EA\u4E0B\u53BB\u770B\uFF0C\u6216\u8005\u82B1\u94B1\u4E70\u522B\u4EBA\u7528\u547D\u6362\u6765\u7684\u6D88\u606F"
  - characterSprite: {fileID: 0}
    content: "\u597D\u4E86\uFF0C\u5DEE\u4E0D\u591A\u5C31\u8FD9\u4E9B\u3002\u53BB\u5427\uFF0C\u5C0F\u63A2\u9669\u5BB6\u3002\u8BA9\u6211\u770B\u770B\u4F60\u8FD9\u8D9F\u80FD\u7ED9\u6211\u2014\u2014\u54B3\uFF0C\u80FD\u7ED9\u8425\u5730\u5E26\u56DE\u4EC0\u4E48\u597D\u4E1C\u897F"
